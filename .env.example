# Copy to .env and adjust. All values are optional; compose has the same defaults.
# Container uses network_mode: host, so this is the port on the host.
MON_PORT=8090

# Collectors: Go durations (10s, 15m, 12h) or bare seconds. 0 disables.
MON_TEMP_INTERVAL=30s
MON_DOCKER_INTERVAL=60s
MON_HOST_INTERVAL=30s
MON_VOLUME_INTERVAL=5m
MON_SMART_INTERVAL=12h
MON_AGGREGATE_INTERVAL=5m

# 48h of minutes -> 90 days of hours -> daily forever. 0 keeps that level forever.
MON_RETENTION_MINUTE=48h
MON_RETENTION_HOUR=2160h
MON_RETENTION_WEAR=17520h

MON_TEMP_WARN_C=80
# Regex over sensor keys (chip:label, nvme:disk). Include replaces the default
# selection (CPU package + NVMe composite); exclude always applies.
MON_TEMP_INCLUDE=
MON_TEMP_EXCLUDE=
MON_DOCKER_EXCLUDE=
MON_LOG_LEVEL=info

# Opt-in CPU/heap profiler for "why is this eating CPU" investigations. Loopback
# only, e.g. 127.0.0.1:6061; empty disables it. See README "Профилирование".
MON_PPROF_ADDR=
