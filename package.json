{
  "name": "mon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite web",
    "build": "vue-tsc -b web/tsconfig.app.json web/tsconfig.node.json && vite build web",
    "preview": "vite preview web",
    "typecheck": "vue-tsc -b web/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "typescript": "~5.9.3",
    "unocss": "^66.13.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
